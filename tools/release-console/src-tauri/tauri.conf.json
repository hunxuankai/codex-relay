{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Relay 发布控制台",
  "mainBinaryName": "CodexRelayReleaseConsole",
  "version": "../package.json",
  "identifier": "com.codexrelay.release-console",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Relay 发布控制台",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../../src-tauri/icons/icon.ico"
    ]
  }
}
