{
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "dompurify": "^3.4.12",
    "element-plus": "^2.14.3",
    "marked": "^18.0.7",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6",
    "@vue/test-utils": "^2",
    "@vue/tsconfig": "^0.8",
    "jsdom": "^26",
    "typescript": "~5.9",
    "unplugin-element-plus": "^0.11.2",
    "vite": "^7",
    "vitest": "^3",
    "vue-tsc": "^3"
  },
  "name": "codex-relay",
  "private": true,
  "scripts": {
    "build": "tauri build",
    "build:debug": "tauri build --debug --no-bundle",
    "build:frontend": "vite build",
    "build:release": "tauri build --config src-tauri/tauri.updater.conf.json",
    "build:release-console": "npm run build:app --workspace @codex-relay/release-console",
    "bundle:nsis": "tauri build --bundles nsis",
    "check": "npm run test:trellis && npm run check:frontend && npm run check:rust",
    "check:frontend": "npm run typecheck && npm run test && npm run typecheck:release-console && npm run test:release-console",
    "check:rust": "npm run check:rust:deps && cargo fmt --all --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets --all-features -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "check:rust-dev-env": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-rust-dev-environment.ps1",
    "check:rust:deps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-rust-dependency-graph.ps1",
    "dev": "tauri dev",
    "dev:frontend": "vite",
    "dev:release-console": "npm run dev --workspace @codex-relay/release-console",
    "dev:safe": "powershell -ExecutionPolicy Bypass -File scripts/prepare-dev-data.ps1",
    "dev:safe:no-watch": "powershell -ExecutionPolicy Bypass -File scripts/prepare-dev-data.ps1 -NoRustWatch",
    "postbuild:release-console": "pwsh -NoProfile -File scripts/package-release-console.ps1",
    "pretest:rust:lib": "npm run check:rust-dev-env",
    "pretest:rust:path-safety": "npm run check:rust-dev-env",
    "pretest:rust:provider-workflow": "npm run check:rust-dev-env",
    "test": "vitest run",
    "test:release-console": "npm run test --workspace @codex-relay/release-console",
    "test:rust-deps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tests/rust-dependency-graph.tests.ps1",
    "test:rust-dev-guard": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tests/rust-dev-scripts.tests.ps1",
    "test:rust:lib": "cargo test --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target -p codex-relay-core --lib",
    "test:rust:path-safety": "cargo test --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target -p codex-relay-core --test path_safety",
    "test:rust:provider-workflow": "cargo test --manifest-path src-tauri/Cargo.toml --target-dir src-tauri/target -p codex-relay-core --test provider_workflow",
    "test:trellis": "python -m unittest discover -s .trellis/scripts/tests -p \"test_*.py\"",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "typecheck:release-console": "npm run typecheck --workspace @codex-relay/release-console"
  },
  "type": "module",
  "version": "0.5.1",
  "workspaces": [
    "tools/release-console"
  ]
}
